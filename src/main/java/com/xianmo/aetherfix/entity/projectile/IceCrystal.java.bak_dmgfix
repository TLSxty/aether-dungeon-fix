package com.xianmo.aetherfix.entity.projectile;

import com.xianmo.aetherfix.entity.ModEntityTypes;
import net.minecraft.core.particles.ParticleOptions;
import net.minecraft.core.particles.ParticleTypes;
import net.minecraft.nbt.CompoundTag;
import net.minecraft.sounds.SoundEvent;
import net.minecraft.sounds.SoundEvents;
import net.minecraft.world.damagesource.DamageSource;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.level.Level;
import net.minecraft.world.phys.BlockHitResult;
import net.minecraft.world.phys.EntityHitResult;

/**
 * 冰晶 —— 1.18.2 自建（B4-1a）。
 *
 * 对齐 1.19.2 com.aetherteam.aether.entity.projectile.crystal.IceCrystal。
 *
 * 【设计要点】
 * - 冰晶是生存模式下唯一能伤害 Sun Spirit 的手段。
 * - 命中 Sun Spirit 时，其 hurt() 会检查 source.getDirectEntity() instanceof IceCrystal，
 *   触发冻结 175 tick + 召唤 FireMinion。
 * - 伤害类型 msgId 为 "aether.ice_crystal"，与 SunSpirit 的 isInvulnerableTo 白名单一致。
 */
public class IceCrystal extends AbstractCrystal implements WeaknessDamage {

    public IceCrystal(EntityType<? extends IceCrystal> type, Level level) {
        super(type, level);
    }

    public IceCrystal(Level level, LivingEntity shooter) {
        super(ModEntityTypes.ICE_CRYSTAL.get(), level);
        this.setOwner(shooter);
        this.setPos(shooter.getX(), shooter.getEyeY() - 0.1, shooter.getZ());
    }

    @Override
    protected void onHitEntity(EntityHitResult result) {
        super.onHitEntity(result);
        if (!this.level.isClientSide) {
            this.doDamage(result.getEntity());
            this.spawnExplosionParticles();
            this.discard();
        }
    }

    @Override
    protected void onHitBlock(BlockHitResult result) {
        super.onHitBlock(result);
        if (!this.level.isClientSide) {
            this.spawnExplosionParticles();
            this.discard();
        }
    }

    /**
     * 弱点伤害：对目标造成 5 点伤害。
     * 伤害源标记为 aether.ice_crystal，以穿透 Sun Spirit 的免疫。
     */
    @Override
    public void doDamage(Entity target) {
        if (target instanceof LivingEntity living) {
            Entity owner = this.getOwner();
            DamageSource source = this.damageSources().thrown(this, owner != null ? owner : this);
            living.hurt(source, 5.0F);
        }
    }

    @Override
    public int getLifeSpan() {
        return 100;
    }

    @Override
    protected ParticleOptions getExplosionParticle() {
        return ParticleTypes.SNOWFLAKE;
    }

    @Override
    public SoundEvent getImpactExplosionSoundEvent() {
        return SoundEvents.GLASS_BREAK;
    }

    @Override
    public void addAdditionalSaveData(CompoundTag tag) {
        super.addAdditionalSaveData(tag);
    }

    @Override
    public void readAdditionalSaveData(CompoundTag tag) {
        super.readAdditionalSaveData(tag);
    }
}
